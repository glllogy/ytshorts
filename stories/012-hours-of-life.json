{
  "id": "hours-of-life",
  "title": "How many hours of your life do these sneakers cost?",
  "voice": "nPczCjzI2devNBz1zQrb",
  "characters": {
    "mike": { "name": "MIKE", "color": "#E5484D" },
    "jake": { "name": "JAKE", "color": "#2E8B57" }
