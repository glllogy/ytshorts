      "type": "willHook",
      "text": "Everyone in town thought this old man was broke. Then they read his will.",
      "props": { "who": "ron", "rumors": ["BROKE?", "POOR GUY", "NO MONEY"], "doc": "LAST WILL" }
    },
    {
      "type": "investResult",
      "text": "Ronald Read, a janitor from Vermont, left behind almost $8 million.",
      "props": { "who": "ron", "to": 8000000, "label": "RONALD'S FORTUNE", "startWord": "left", "endWord": "$8", "rateLabel": "" }
    },
    {
      "type": "factsList",
      "text": "He pumped gas for years. Then he swept floors. He drove a used car and cut his own firewood.",
      "props": { "who": "ron", "title": "HIS LIFE", "facts": [
        { "word": "pumped", "label": "PUMPED GAS" },
        { "word": "swept", "label": "JANITOR" },
