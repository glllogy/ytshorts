        { "word": "firewood", "label": "CUT OWN FIREWOOD" }
      ] }
    },
    {
      "type": "certStack",
      "text": "His secret? He kept buying stock in big, boring companies he understood. And he almost never sold.",
      "props": { "who": "ron", "title": "HIS SECRET", "buyWord": "buying", "holdWord": "never", "hold": "NEVER SOLD" }
    },
    {
      "type": "goldWorks",
      "text": "The dividends? He reinvested them. Year after year, for decades.",
      "props": { "who": "ron", "title": "DIVIDENDS", "sub": "REINVESTED", "titleWord": "dividends", "genWords": ["dividends", "reinvested", "year", "decades"] }
    },
    {
      "type": "breakdown",
      "text": "When he died at 92, he gave most of it away. $4.8 million to the local hospital, and $1.2 million to the library.",
      "props": { "aWord": "$4.8", "bWord": "$1.2", "noPlus": true, "parts": [ { "label": "HOSPITAL", "value": 4800000, "color": "#3B82F6" }, { "label": "LIBRARY", "value": 1200000, "color": "#22C55E" } ] }
    },
    {
      "type": "lesson",
      "text": "No big salary. No lucky bet. Just small amounts, held for a very long time.",
      "props": { "who": "ron", "line1": "SMALL AMOUNTS", "line2": "LONG TIME", "switchWord": "just", "vs": "curve" }
